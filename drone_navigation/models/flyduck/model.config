<?xml version="1.0"?>

<model>
  <name>flyduck</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    QAV250 quadcopter matching the FlyDuck hardware build:
    250 mm diagonal, 5 inch props, ~0.9 kg all-up.
    Carries an RPLIDAR C1 (360 deg, 8 cm above base_link) and a
    down-facing TeraRanger Evo Mini. Flown by ArduPilot SITL via
    ArduPilotPlugin.
  </description>
</model>
